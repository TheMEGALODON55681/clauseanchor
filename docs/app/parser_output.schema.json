{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParsedDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text_sha256",
    "parser_version",
    "media_type",
    "page_count",
    "blocks",
    "nodes",
    "decorations",
    "warnings",
    "coverage"
  ],
  "properties": {
    "source_text": {
      "type": "string"
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parser_version": {
      "type": "string"
    },
    "media_type": {
      "enum": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ]
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Block"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StructureNode"
      }
    },
    "decorations": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ParseWarning"
      }
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    }
  },
  "$defs": {
    "Block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "start",
        "end",
        "page",
        "bbox",
        "locator"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "table_cell",
            "header",
            "footer",
            "footnote"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "locator": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "integer",
              "string"
            ]
          }
        }
      }
    },
    "StructureNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent_id",
        "kind",
        "label",
        "level",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "heading",
            "section",
            "clause",
            "subclause",
            "schedule",
            "definition",
            "table"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        }
      }
    },
    "ParseWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "page",
        "detail"
      ],
      "properties": {
        "code": {
          "enum": [
            "COLUMN_ORDER_UNCERTAIN",
            "MORE_THAN_TWO_COLUMNS",
            "BLANK_PAGE",
            "NUMBERING_AMBIGUOUS",
            "NUMBERING_NOT_RENDERED",
            "TEXT_BOX_CONTENT",
            "EMBEDDED_OBJECT",
            "UNSUPPORTED_DOCX_FEATURE",
            "PARTIALLY_SCANNED_PDF"
          ]
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages_total",
        "pages_with_text",
        "chars",
        "partial"
      ],
      "properties": {
        "pages_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "pages_with_text": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "chars": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "boolean"
        }
      }
    }
  }
}
