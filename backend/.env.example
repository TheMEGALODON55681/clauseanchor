# Backend configuration names with placeholder values only. Never commit secrets.
# The API reads the process environment and does not load this file, so export these in your shell.
# Every variable is optional. The values below are the defaults, except the artifacts directory.
CLAUSEANCHOR_ANALYZER=stub
# CLAUSEANCHOR_ARTIFACTS_DIR=/path/to/artifacts   # required when CLAUSEANCHOR_ANALYZER=real
CLAUSEANCHOR_DB_PATH=:memory:
CLAUSEANCHOR_SESSION_TTL_MINUTES=60
CLAUSEANCHOR_PARSE_KILL_SECONDS=120
CLAUSEANCHOR_PARSE_QUEUE_LENGTH=2
